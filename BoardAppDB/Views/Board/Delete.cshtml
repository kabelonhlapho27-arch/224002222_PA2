@model BoardAppDB.Models.Board

@{
    ViewData["Title"] = "Delete";
}

<h1>Delete Board</h1>

@if (ViewBag.SuccessMessage != null)
{
    <div class="alert alert-success">@ViewBag.SuccessMessage</div>
}

<h4>Are you sure you want to delete this?</h4>
<hr />

<form asp-action="Delete" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <input type="hidden" asp-for="BoardCode" />

    <div class="form-group">
        <label asp-for="BoardCode" class="control-label"></label>
        <input asp-for="BoardCode" class="form-control" readonly />
    </div>

    <div class="form-group">
        <label asp-for="Make" class="control-label"></label>
        <input asp-for="Make" class="form-control" readonly />
    </div>

    <div class="form-group">
        <label asp-for="Model" class="control-label"></label>
        <input asp-for="Model" class="form-control" readonly />
    </div>

    <div class="form-group">
        <label asp-for="FlashKb" class="control-label"></label>
        <input asp-for="FlashKb" class="form-control" readonly />
    </div>

    <div class="form-group">
        <label asp-for="Price" class="control-label"></label>
        <input asp-for="Price" class="form-control" readonly />
    </div>

    <div class="form-group">
        @if (ViewBag.ShowDelete == null || ViewBag.ShowDelete == true)
        {
            <button type="submit" class="btn btn-danger">Delete</button>
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
        }
        else
        {
            <a asp-action="Index" class="btn btn-secondary">Back to List</a>
        }
    </div>
</form>
